# Copy this to .env and fill in your values
# cp .env.example .env

# Required — Supabase (service_role key, not management token)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=

# Optional — unlocks additional data providers
FRED_API_KEY=
ALLIUM_API_KEY=
COINMETRICS_API_KEY=
COINGECKO_API_KEY=
DUNE_API_KEY=

# Rust log level (error | warn | info | debug | trace)
RUST_LOG=info
