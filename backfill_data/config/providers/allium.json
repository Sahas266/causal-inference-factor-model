{
  "provider_name": "allium",
  "display_name": "Allium Developer API",
  "enabled": true,
  "api_config": {
    "base_url": "https://api.allium.so/api/v1",
    "api_key_env": "ALLIUM_API_KEY"
  },
  "rate_limits": {
    "requests_per_window": 60,
    "window_seconds": 60,
    "safety_margin": 0.9
  },
  "retry_config": {
    "max_attempts": 3,
    "backoff_multiplier": 2,
    "max_wait_seconds": 120
  },
  "capabilities": [
    "token_price_history",
    "dex_trades"
  ],
  "description": "Allium Developer REST API provides token price history and DEX trade data. Uses subscription-based endpoints (not Explorer SQL which requires separate credits)."
}
