{
  "provider_name": "allium",
  "display_name": "Allium Explorer",
  "enabled": true,
  "api_config": {
    "base_url": "https://api.allium.so/api/v1",
    "api_key_env": "ALLIUM_API_KEY"
  },
  "rate_limits": {
    "requests_per_window": 60,
    "window_seconds": 60,
    "safety_margin": 0.9
  },
  "retry_config": {
    "max_attempts": 3,
    "backoff_multiplier": 2,
    "max_wait_seconds": 120
  },
  "capabilities": [
    "on_chain_metrics",
    "dex_metrics",
    "asset_metrics"
  ],
  "description": "Allium provides historical blockchain data via a Snowflake SQL explorer API. Supports Ethereum, Bitcoin, Solana, and 20+ other chains."
}
