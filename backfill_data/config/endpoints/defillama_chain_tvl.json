{
  "endpoint_id": "defillama_chain_tvl_daily",
  "description": "Historical total value locked (TVL) for Ethereum and other major chains via DefiLlama",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "chain/tvl",
        "params": {
          "schema_type": "chain_tvl",
          "chain": "Ethereum",
          "asset": "ethereum"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
