{
  "endpoint_id": "eth_fees_defillama",
  "description": "Uniswap, Lido, and Aave daily fees from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "fees/summary",
        "params": {
          "schema_type": "fees",
          "protocol": "uniswap",
          "data_type": "dailyFees",
          "asset": "uniswap"
        }
      }
    },
    {
      "name": "defillama",
      "enabled": true,
      "priority": 2,
      "config": {
        "endpoint_type": "fees/summary",
        "params": {
          "schema_type": "fees",
          "protocol": "lido",
          "data_type": "dailyFees",
          "asset": "lido"
        }
      }
    },
    {
      "name": "defillama",
      "enabled": true,
      "priority": 3,
      "config": {
        "endpoint_type": "fees/summary",
        "params": {
          "schema_type": "fees",
          "protocol": "aave",
          "data_type": "dailyFees",
          "asset": "aave"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
