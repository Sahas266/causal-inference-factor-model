{
  "endpoint_id": "eth_stablecoin_flow_defillama",
  "description": "Ethereum stablecoin circulating USD from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "stablecoin/charts",
        "params": {
          "schema_type": "stablecoin_flow",
          "chain": "Ethereum",
          "asset": "eth_stablecoins"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
