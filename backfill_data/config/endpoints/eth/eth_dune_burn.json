{
  "endpoint_id": "dune_eth_burn_issuance",
  "description": "Daily ETH burned via EIP-1559 from Dune",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-08-05",
    "end": "latest"
  },
  "providers": [
    {
      "name": "dune",
      "enabled": true,
      "priority": 4,
      "config": {
        "endpoint_type": "query_results",
        "params": {
          "schema_type": "query_results",
          "query_id": 6811496,
          "asset": "eth",
          "limit": 10000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
