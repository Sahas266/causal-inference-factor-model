{
  "endpoint_id": "eth_dex_volumes_defillama",
  "description": "Uniswap and Curve daily DEX volume from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "dex/summary",
        "params": {
          "schema_type": "dex_volumes",
          "protocol": "uniswap",
          "asset": "uniswap"
        }
      }
    },
    {
      "name": "defillama",
      "enabled": true,
      "priority": 2,
      "config": {
        "endpoint_type": "dex/summary",
        "params": {
          "schema_type": "dex_volumes",
          "protocol": "curve-dex",
          "asset": "curve"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
