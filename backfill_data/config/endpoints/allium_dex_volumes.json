{
  "endpoint_id": "allium_dex_daily_volumes",
  "description": "Daily DEX trade volumes on Ethereum from Allium Developer API",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "allium",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "developer/ethereum/dex/trades",
        "params": {
          "schema_type": "dex_trades",
          "chain": "ethereum",
          "asset": "ethereum_dex",
          "limit": 1000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
