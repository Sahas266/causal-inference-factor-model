{
  "endpoint_id": "dune_bnb_liquidations",
  "description": "Daily DeFi lending liquidations on BNB Chain: count, volume, unique liquidators",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "latest"
  },
  "providers": [
    {
      "name": "dune",
      "enabled": true,
      "priority": 4,
      "config": {
        "endpoint_type": "query_results",
        "params": {
          "schema_type": "query_results",
          "query_id": 6831687,
          "asset": "bnb",
          "limit": 10000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
