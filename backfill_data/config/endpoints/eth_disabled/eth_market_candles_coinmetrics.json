{
  "endpoint_id": "eth_market_candles_coinmetrics",
  "description": "ETH spot market candles for Coinbase and Binance",
  "table": "market_candles",
  "primary_keys": [
    "provider",
    "market",
    "time"
  ],
  "date_range": {
    "start": "2025-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "coinmetrics",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "timeseries/market-candles",
        "params": {
          "markets": "coinbase-eth-usd-spot,binance-eth-usdt-spot",
          "frequency": "1d",
          "page_size": 10000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
