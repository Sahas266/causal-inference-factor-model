{
  "endpoint_id": "allium_eth_on_chain_daily",
  "description": "Daily Ethereum on-chain block data from Allium Developer API",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "allium",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "developer/prices/history",
        "params": {
          "schema_type": "token_price_history",
          "asset": "eth",
          "addresses": [
            {
              "chain": "ethereum",
              "token_address": "0xc02aaa39b223fe8d0a0e5c4f27ead9083c756cc2"
            }
          ],
          "time_granularity": "1d"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
