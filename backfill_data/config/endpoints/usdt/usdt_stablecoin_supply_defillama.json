{
  "endpoint_id": "usdt_stablecoin_supply_defillama",
  "description": "Tether stablecoin circulating supply from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": [
    "provider",
    "asset",
    "metric",
    "time"
  ],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 2,
      "config": {
        "endpoint_type": "stablecoin/charts",
        "params": {
          "schema_type": "stablecoin_flow",
          "chain": "all",
          "stablecoin_id": 1,
          "asset": "usdt"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
