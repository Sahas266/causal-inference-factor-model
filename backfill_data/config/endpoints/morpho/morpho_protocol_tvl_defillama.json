{
  "endpoint_id": "morpho_protocol_tvl_defillama",
  "description": "Morpho protocol TVL from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": [
    "provider",
    "asset",
    "metric",
    "time"
  ],
  "date_range": {
    "start": "2024-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "protocol/tvl",
        "params": {
          "schema_type": "protocol_tvl",
          "protocol": "morpho",
          "asset": "morpho"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
