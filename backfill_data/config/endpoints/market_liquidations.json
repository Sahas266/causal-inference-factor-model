{
    "endpoint_id": "market_liquidations_btc_eth",
    "description": "Liquidation events for BTC and ETH futures markets",
    "table": "market_liquidations",
    "primary_keys": [
        "provider",
        "market",
        "time",
        "coin_metrics_id"
    ],
    "date_range": {
        "start": "2021-01-01",
        "end": "2026-01-01"
    },
    "providers": [
        {
            "name": "coinmetrics",
            "enabled": true,
            "priority": 1,
            "config": {
                "endpoint_type": "timeseries/market-liquidations",
                "params": {
                    "markets": "binance-BTCUSDT-future,binance-ETHUSDT-future",
                    "page_size": 10000
                }
            }
        }
    ],
    "fallback_strategy": "use_all",
    "deduplication": {
        "strategy": "prefer_priority",
        "conflict_resolution": "keep_highest_priority"
    }
}