{
  "endpoint_id": "doge_asset_metrics_coinmetrics",
  "description": "Dogecoin core market and on-chain metrics from CoinMetrics",
  "table": "asset_metrics",
  "primary_keys": [
    "provider",
    "asset",
    "metric",
    "time"
  ],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "coinmetrics",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "timeseries/asset-metrics",
        "params": {
          "assets": "doge",
          "metrics": "PriceUSD,CapMrktCurUSD,TxCnt,AdrActCnt,SplyCur,BlkCnt,HashRate,FeeTotNtv,IssTotNtv,TxTfrCnt",
          "frequency": "1d",
          "page_size": 10000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
