{
  "endpoint_id": "dune_uni_lp_flows",
  "description": "Uniswap V3 daily LP inflow/outflow/net flow USD on Ethereum from Dune query 6854380. The query was ingested historically but had no endpoint config, so nothing re-fetched it and the series froze at 2025-12-31.",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "latest"
  },
  "providers": [
    {
      "name": "dune",
      "enabled": true,
      "priority": 4,
      "config": {
        "endpoint_type": "query_results",
        "params": {
          "schema_type": "query_results",
          "query_id": 6854380,
          "asset": "uni",
          "limit": 10000
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
