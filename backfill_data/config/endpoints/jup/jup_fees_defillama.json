{
  "endpoint_id": "jup_fees_defillama",
  "description": "Jupiter daily fees from DefiLlama",
  "table": "asset_metrics",
  "primary_keys": [
    "provider",
    "asset",
    "metric",
    "time"
  ],
  "date_range": {
    "start": "2024-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "defillama",
      "enabled": true,
      "priority": 2,
      "config": {
        "endpoint_type": "fees/summary",
        "params": {
          "schema_type": "fees",
          "protocol": "jupiter",
          "data_type": "dailyFees",
          "asset": "jup"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
