{
    "endpoint_id": "market_candles_btc_eth",
    "description": "Exchange-specific OHLCV candles for BTC and ETH spot markets",
    "table": "market_candles",
    "primary_keys": [
        "provider",
        "market",
        "time"
    ],
    "date_range": {
        "start": "2021-01-01",
        "end": "2026-01-01"
    },
    "providers": [
        {
            "name": "coinmetrics",
            "enabled": true,
            "priority": 1,
            "config": {
                "endpoint_type": "timeseries/market-candles",
                "params": {
                    "markets": "coinbase-btc-usd-spot,binance-btc-usdt-spot,coinbase-eth-usd-spot,binance-eth-usdt-spot",
                    "frequency": "1d",
                    "page_size": 10000
                }
            }
        }
    ],
    "fallback_strategy": "use_all",
    "deduplication": {
        "strategy": "prefer_priority",
        "conflict_resolution": "keep_highest_priority"
    }
}