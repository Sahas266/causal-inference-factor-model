{
  "endpoint_id": "fred_labor_growth",
  "description": "US labor market and growth from FRED: unemployment, payrolls, jobless claims, GDP, industrial production",
  "table": "asset_metrics",
  "primary_keys": ["provider", "asset", "metric", "time"],
  "date_range": {
    "start": "2021-01-01",
    "end": "2026-01-01"
  },
  "providers": [
    {
      "name": "fred",
      "enabled": true,
      "priority": 1,
      "config": {
        "endpoint_type": "series/observations",
        "params": {
          "schema_type": "series_observations",
          "series_ids": "UNRATE,PAYEMS,ICSA,GDPC1,INDPRO",
          "asset": "macro"
        }
      }
    }
  ],
  "fallback_strategy": "use_all",
  "deduplication": {
    "strategy": "prefer_priority",
    "conflict_resolution": "keep_highest_priority"
  }
}
