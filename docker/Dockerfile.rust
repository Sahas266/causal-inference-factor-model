# ── Stage 1: Build ─────────────────────────────────────────────────────────
FROM rust:1.88-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Cache dependencies before copying source
COPY causal_model/Cargo.toml causal_model/Cargo.lock ./
COPY causal_model/crates ./crates

RUN cargo build --release --bin cpcm

# ── Stage 2: Runtime ────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=builder /build/target/release/cpcm ./cpcm
COPY causal_model/config.toml ./config.toml

# Run graph summary by default (fast, no Supabase required).
# Override via: docker compose run rust ./cpcm run
CMD ["./cpcm", "graph"]
